# Create an app at https://www.linkedin.com/developers/ and configure its redirect URI.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback
# Only request scopes/products enabled for your app.
LINKEDIN_SCOPES=openid profile email w_member_social
# Check LinkedIn's current API version documentation before deployment.
LINKEDIN_API_VERSION=202601
LINKEDIN_TOKEN_PATH=~/.linkedin-mcp/token.json
# stdio is easiest for local MCP clients. streamable-http is for a secured remote deployment.
MCP_TRANSPORT=stdio
